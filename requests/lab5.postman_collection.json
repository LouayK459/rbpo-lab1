    {
      "name": "08 Rotate refresh (old USED, new ACTIVE)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{refreshToken}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const previousAccess = pm.collectionVariables.get(\"accessToken\");",
              "const previousRefresh = pm.collectionVariables.get(\"refreshToken\");",
              "const pair = pm.response.json();",
              "pm.test(\"Both tokens returned\", () => { pm.expect(pair.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(pair.refreshToken).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"accessToken\", pair.accessToken);",
              "pm.collectionVariables.set(\"refreshToken\", pair.refreshToken);",
              "pm.test(\"Both tokens changed\", () => { pm.expect(pair.accessToken).not.to.eql(previousAccess); pm.expect(pair.refreshToken).not.to.eql(previousRefresh); });"
            ]
          }
        }
      ]
    },
