{
  "info": {
    "name": "RBPO Lab 5 — JWT Access/Refresh and sessions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Supply dispatcherPassword locally. Requests 06–11 demonstrate rotation and replay; inspect database states with db/lab5-check.sql. Registration creates its own ACTIVE session before the login scenario. Generated demo credentials and tokens are local collection variables; clear them before exporting."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "dispatcherUsername",
      "value": "dispatcher"
    },
    {
      "key": "dispatcherPassword",
      "value": ""
    },
    {
      "key": "testUsername",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "oldAccessToken",
      "value": ""
    },
    {
      "key": "oldRefreshToken",
      "value": ""
    },
    {
      "key": "dispatcherAccess",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register a SENDER (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Lab 5 Postman sender\", \"username\": \"{{testUsername}}\", \"password\": \"{{testPassword}}\", \"deviceId\": \"postman-lab5\", \"role\": \"DISPATCHER\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now() + \"-\" + Math.floor(Math.random() * 1000000);",
              "pm.collectionVariables.set(\"testUsername\", \"lab5postman-\" + suffix);",
              "pm.collectionVariables.set(\"testPassword\", \"Lab5-Postman-\" + suffix + \"!\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const pair = pm.response.json();",
              "pm.test(\"Both tokens returned\", () => { pm.expect(pair.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(pair.refreshToken).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"accessToken\", pair.accessToken);",
              "pm.collectionVariables.set(\"refreshToken\", pair.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Registration gives immediate protected access; role remains SENDER",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"SENDER role\", () => pm.expect(pm.response.json().role).to.eql(\"SENDER\"));",
              "pm.collectionVariables.set(\"userId\", pm.response.json().userId);"
            ]
          }
        }
      ]
    },
    {
