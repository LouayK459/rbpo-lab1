          "raw": "{\"username\": \"{{dispatcherUsername}}\", \"password\": \"{{dispatcherPassword}}\", \"deviceId\": \"postman-dispatcher\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"dispatcherAccess\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Dispatcher can list routes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
