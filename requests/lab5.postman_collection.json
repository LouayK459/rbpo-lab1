              "pm.test(\"No token pair on refusal\", () => { const body = pm.response.json(); pm.expect(body).not.to.have.property(\"accessToken\"); pm.expect(body).not.to.have.property(\"refreshToken\"); });"
            ]
          }
        }
      ]
    },
